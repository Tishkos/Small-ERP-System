# ============================================================================
# Arbati ERP - Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored; never commit real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (required)
# ----------------------------------------------------------------------------
# PostgreSQL connection string. Used by Prisma and the app at runtime.
# Docker Compose users: host is the service name (`db`), not `localhost`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arbati?schema=public"

# ----------------------------------------------------------------------------
# Authentication (required)
# ----------------------------------------------------------------------------
# Generate a strong value for each of these, e.g.:
#   openssl rand -base64 32
# AUTH_SECRET is the one that matters: it signs the NextAuth session JWT.
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Only used as a fallback by the middleware. Keep it equal to AUTH_SECRET, or
# leave it unset.
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
JWT_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public URL of the app. Must match the browser origin in production.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ----------------------------------------------------------------------------
# Email / SMTP (optional)
# ----------------------------------------------------------------------------
# Sign-in is password-based and sends no email, so these are only needed if you
# enable notifications below. The app accepts either the EMAIL_* or the SMTP_*
# names; EMAIL_* wins.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="no-reply@example.com"

# Address that receives new-account approval requests.
APPROVAL_EMAIL="admin@example.com"

# ----------------------------------------------------------------------------
# Localization
# ----------------------------------------------------------------------------
# One of: ku (Kurdish), en (English), ar (Arabic)
DEFAULT_LOCALE="ku"

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
ENABLE_EMAIL_NOTIFICATIONS="false"
ENABLE_LOW_STOCK_ALERTS="true"
# Audit logging is on unless explicitly set to "false".
ENABLE_AUDIT_LOGGING="true"

# ----------------------------------------------------------------------------
# Seed data (used by `npm run db:seed`)
# ----------------------------------------------------------------------------
# Defaults create an admin / admin account so a fresh install is usable
# immediately. Leaving SEED_ADMIN_PASSWORD at "admin" makes the app demand a new
# password on first sign-in; setting your own here skips that prompt.
SEED_COMPANY_NAME="My Company"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin"
SEED_ADMIN_NAME="Administrator"
